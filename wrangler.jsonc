// The website on Cloudflare Workers (docs/deploy.md). Nothing here is a secret.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The site's public address starts with this name.
  "name": "logement-etudiant",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      // The hosted database, as the website sees it (app/database.ts).
      "binding": "DB",
      "database_name": "student-housing",
      // Replace with the identifier "npx wrangler d1 create student-housing" prints.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
