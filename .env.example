# Two files, both kept out of the repository. Real values never go in the repository.

# --- .env.local: the website ---
# Everything in .env.local is copied into the site sent to Cloudflare (docs/deploy.md),
# so it holds this one line and never a key.

# The site owner's address: "Signaler cette annonce" on every listing opens an email to it.
REPORT_EMAIL=

# --- .env.collect: the collection run (npm run collect) ---
APIFY_API_KEY=
GEMINI_API_KEY=
# Optional last-resort model
GROQ_API_KEY=

# The daily run on GitHub uses no file: APIFY_API_KEY, GEMINI_API_KEY, CLOUDFLARE_API_TOKEN and
# CLOUDFLARE_ACCOUNT_ID are secrets of the repository there (docs/daily-collection.md).
