{
  "name": "student-housing-search",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "tsx db/hosted.ts schema --preview && tsx db/hosted.ts fill --preview && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && tsx check-before-deploy.ts && opennextjs-cloudflare deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "collect": "tsx --env-file=.env.collect collection/run.ts",
    "collect:hosted": "tsx collection/run.ts --hosted",
    "sql": "tsx db/sql.ts",
    "evaluate": "tsx --env-file=.env.collect collection/extract/evaluate.ts",
    "hosted:schema": "tsx db/hosted.ts schema",
    "hosted:fill": "tsx db/hosted.ts fill",
    "hosted:sql": "tsx db/sql.ts --hosted"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.8",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
